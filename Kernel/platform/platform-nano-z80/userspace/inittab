# Inittab
id:3:initdefault:
# Start a shell first
# si::sysinit:/bin/sh
# Run level s - a shell
is:s:respawn:/bin/sh
# Start up
rc::bootwait:/etc/rc
# Terminals
01:3:respawn:getty /dev/tty1 0 fuzix 80 30
02:3:respawn:getty /dev/tty2 0 fuzix 80 30
03:3:respawn:getty /dev/tty3 0 fuzix 80 30
04:3:respawn:getty /dev/tty4 0 fuzix 80 30
05:3:respawn:getty /dev/tty5 115200 xterm 80 24
06:3:off:getty /dev/tty6 9600 xterm 80 24
# Reboot
bt:5:wait:/etc/rc.reboot
# Shutdown
ht:6:wait:/etc/rc.halt
