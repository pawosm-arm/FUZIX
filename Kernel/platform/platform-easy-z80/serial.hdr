;
;	Dual SIO serial driver. For latency reasons this all
;	lives in the fixed bank space
;
#include "kernelu.def"

;=========================================================================
; Constants
;=========================================================================

RTS_HIGH	.equ	0xE8
RTS_LOW		.equ	0xEA

; Base address of SIO/2 chip 0x80. On board SIO has D/C backwards to RC2014!

SIOA_D		.equ	0x80
SIOA_C		.equ	SIOA_D+1
SIOB_D		.equ	SIOA_D+2
SIOB_C		.equ	SIOA_D+3


	.export _sio_state
	.export _sio_dropdcd
	.export _sio_rxl
	.export _sio_txl

; These are laid out and exposed as arrays to C
_sio_wr5:
_sioa_wr5:
	.byte 0xEA		; DTR, 8bit, tx enabled
_siob_wr5:
	.byte 0xEA		; DTR, 8bit, tx enabled
_sio_flow:
_sioa_flow:
	.byte 0			; Flow starts off
_siob_flow:
	.byte 0			; Flow starts off
_sio_state:
_sioa_state:
	.byte 0			; Last status report
_siob_state:
	.byte 0			; Last status report
_sio_dropdcd:
_sioa_dropdcd:
	.byte 0			; DCD dropped since last checked
_siob_dropdcd:
	.byte 0			; DCD dropped since last checked
_sio_rxl:
_sioa_rxl:
	.byte 0
_siob_rxl:
	.byte 0
_sio_txl:
_sioa_txl:
	.byte 0
_siob_txl:
	.byte 0
sio_sp:
	.word 0

	.code
;
;	A little SIO helper
;
	.export _sio2_otir

_sio2_otir:
	pop	de
	pop	hl
	push	hl
	push	de
	push	bc
	ld	b,0x06
	ld	c,l
	ld	hl,_sio_r
	otir
	pop	bc
	ret

	.common

	.export outchar
	.export inchar

outchar:
	push	af
	; wait for transmitter to be idle
ocloop_sio:
        xor	a                   ; read register 0
        out	(SIOA_C), a
	in	a,(SIOA_C)		; read Line Status Register
	and	0x04			; get THRE bit
	jr	z,ocloop_sio
	; now output the char to serial port
	pop	af
	out	(SIOA_D),a
	ret

inchar:
inchar_s:
        xor a                           ; read register 0
        out (SIOA_C), a
	in a,(SIOA_C)   		; read Line Status Register
	and 0x01			; test if data is in receive buffer
	jr z,inchar_s			; no data, wait
	in a,(SIOA_D)   		; read the character from the UART
	ret

	.common

        .export	sio_install
	.export sio_set_vectors
	.export outchar
	.export inchar

sio_install:
	ld	hl,sio_setup
	ld	bc,0x0A00 + SIOA_C	; 10 bytes to SIOA_C
	otir
	ld	hl,sio_setup
	ld	bc,0x0C00 + SIOB_C	; and 12 to SIOB_C (vector)
	otir
sio_set_vectors:
        ld	hl,siovec
        ld	de,0x90
        ld	bc,16
        ldir
        ret

siovec:
        .word	siob_txd
        .word	siob_status
        .word	siob_rx_ring
        .word	siob_special
        .word	sioa_txd
        .word	sioa_status
        .word	sioa_rx_ring
        .word	sioa_special

RTS_HIGH	.equ	0xE8
RTS_LOW		.equ	0xEA

sio_setup:
	.byte	0x00
	.byte	0x18		; Reset
	.byte	0x04
	.byte	0xC4
	.byte	0x01
	.byte	0x1F
	.byte	0x03
	.byte	0xC1
	.byte	0x05
	.byte	RTS_LOW
	.byte	0x02
	.byte	0x90		; vector 0x90 for serial (0x80 for CTC)

