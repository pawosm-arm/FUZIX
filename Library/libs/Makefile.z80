CC = fcc -mz80
ASM = fcc -mz80
AR = ar
PLATFORM = z80
export PLATFORM
CC_OPT = -c -I$(shell pwd)/../include -I$(shell pwd)/../include/$(PLATFORM) -X -O
ASM_OPT = -c -o
LORDER = lorderz80
ENDIAN =
SRC_C = htons.o htonl.o
SRC_ASM = setjmp_$(PLATFORM).s longjmp_$(PLATFORM).s
SRC_CRT0 = crt0_$(PLATFORM).s crt0nostdio_$(PLATFORM).s

include Makefile.common
