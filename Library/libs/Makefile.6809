CC = fcc -m6809
ASM = fcc -m6809
AR = ar
PLATFORM = 6809
export PLATFORM
CC_OPT = -c -I$(shell pwd)/../include -I$(shell pwd)/../include/$(PLATFORM) -X -Os
ASM_OPT = -c -o
LORDER = lorder6800
ENDIAN = -X
SRC_C =
SRC_ASM = setjmp_$(PLATFORM).s longjmp_$(PLATFORM).s
SRC_CRT0 = crt0_$(PLATFORM).s crt0nostdio_$(PLATFORM).s crt0_$(PLATFORM)_rel.s crt0nostdio_$(PLATFORM)_rel.s

include Makefile.common
