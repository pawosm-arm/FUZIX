CC = fcc -m6809
AS = fcc -m6809
LINKER = $(FUZIX_ROOT)/Library/link/ld6809
CFLAGS = -O -X -m6809 -D__STDC__ -c -I$(FUZIX_ROOT)/Library/include -I$(FUZIX_ROOT)/Library/include/6809
LINKER_OPT =
LINKER_TAIL = -L $(FUZIX_ROOT)/Library/libs -lc6809 -M
AS_OPT = -o
CRT0 = $(FUZIX_ROOT)/Library/libs/crt0_6809_rel.o
CRT0NS = $(FUZIX_ROOT)/Library/libs/crt0nostdio_6809_rel.o
HOSTCC = cc
.SUFFIXES: .c .o

